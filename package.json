{
  "name": "blanko",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/bots",
    "packages/protocol",
    "packages/lab",
    "packages/server",
    "packages/app"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "lab": "node packages/lab/src/main.ts",
    "server": "node packages/server/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
